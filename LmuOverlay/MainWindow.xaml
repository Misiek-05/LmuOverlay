<Window x:Class="LmuOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LmuOverlay"
        mc:Ignorable="d"
        Title="MainWindow" Height="400" Width="600">
    <Grid>
        
        <Grid.RowDefinitions>
            <RowDefinition Height=".8*"/>
            <RowDefinition Height=".2*"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="1" Name="ConnectToGameButton" Width="80" Height="40" Click="ConnectToGameButton_Click" Content="Connect"/>
        <Button Grid.Row="1" Name="PlayerBestLapsWindowButton" Visibility="Hidden" Width="80" Height="40" Click="PlayerBestLapsWindowButton_Click" Content="Your laps" Margin="0, 0, 170, 0"/>
        <Button Grid.Row="1" Name="TelemetryWindowButton" Visibility="Hidden" Width="80" Height="40" Click="TelemetryWindowButton_Click" Content="Telemetry"/>
        <Button Grid.Row="1" Name="LeaderboardWindowButton" Visibility="Hidden" Width="80" Height="40" Click="LeaderboardWindowButton_Click" Content="Leaderboard" Margin="170, 0, 0, 0"/>
        <Button Grid.Row="1" Name="ExportToXMLBUtton" Visibility="Hidden" Width="80" Height="40" Click="ExportToXMLBUtton_Click" Content="Export Data" Margin="340, 0, 0, 0"/>
    </Grid>
</Window>
