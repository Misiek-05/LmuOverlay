<Window x:Class="LmuOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LMU Overlay" Height="400" Width="400"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        MouseDown="Window_MouseDown">

    <Border Background="#E6111111" CornerRadius="16" Padding="15" BorderBrush="#00FF88" BorderThickness="2">
        <Grid>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="GearText" Text="N" Foreground="#00FF88" FontSize="45" FontWeight="Black" HorizontalAlignment="Center"/>
                <TextBlock x:Name="SpeedText" Text="0 km/h" Foreground="White" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock x:Name="RpmText" Text="RPM: 0" Foreground="#AAAAAA" FontSize="16" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>