<Window x:Class="LmuOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LmuOverlay"
        mc:Ignorable="d"
        Title="MainWindow" Height="400" Width="600">
    <Grid>
        
        <Grid.RowDefinitions>
            <RowDefinition Height=".8*"/>
            <RowDefinition Height=".2*"/>
        </Grid.RowDefinitions>
        
        <Button Grid.Row="1" Name="TelemetryWindowButton" Width="80" Height="40" Click="TelemetryWindowButton_Click" Content="Telemetry"/>
        <Button Grid.Row="1" Name="LeaderboardWindowButton" Width="80" Height="40" Click="LeaderboardWindowButton_Click" Content="Leaderboard" Margin="170, 0, 0, 0"/>
    </Grid>
</Window>
