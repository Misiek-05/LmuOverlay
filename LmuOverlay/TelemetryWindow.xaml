<Window x:Class="LmuOverlay.TelemetryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="300" Width="600"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        MouseDown="Window_MouseDown">

    <Border Background="#E6111111" CornerRadius="16" Padding="15" BorderBrush="#00FF88" BorderThickness="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height=".20*"/>
                <RowDefinition Height=".80*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width=".20*"/>
                <ColumnDefinition Width=".30*"/>
                <ColumnDefinition Width=".20*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="1" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Rectangle Name="RpmLight1" Grid.Column="0" Fill="Transparent" Margin="5,5,5,5"/>
                <Rectangle Name="RpmLight2" Grid.Column="1" Fill="Transparent" Margin="5,5,5,5"/>
                <Rectangle Name="RpmLight3" Grid.Column="2" Fill="Transparent" Margin="5,5,5,5"/>
                <Rectangle Name="RpmLight4" Grid.Column="3" Fill="Transparent" Margin="5,5,5,5"/>
                <Rectangle Name="RpmLight5" Grid.Column="4" Fill="Transparent" Margin="5,5,5,5"/>
                <Rectangle Name="RpmLight6" Grid.Column="5" Fill="Transparent" Margin="5,5,5,5"/>
                <Rectangle Name="RpmLight7" Grid.Column="6" Fill="Transparent" Margin="5,5,5,5"/>
                <Rectangle Name="RpmLight8" Grid.Column="7" Fill="Transparent" Margin="5,5,5,5"/>
                
            </Grid>

            <Grid Grid.Column="2" Grid.Row="0">
                <TextBlock Name="TotalLaps" Foreground="White" Text="LAP: 0" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20"/>
            </Grid>
            
            <Grid Grid.Row="1" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height=".1*"/>
                    <RowDefinition Height=".4*"/>
                    <RowDefinition Height=".1*"/>
                    <RowDefinition Height=".4*"/>
                    <RowDefinition Height=".1*"/>
                    <RowDefinition Height=".4*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock Text="TYRE TMP" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" />
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <TextBlock Name="FrontLeftWheelTmp" Text="" Foreground="White" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15"/>
                    <TextBlock Name="FrontRightWheelTmp" Text="" Foreground="White" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15"/>
                    <TextBlock Name="RearLeftWheelTmp" Text="" Foreground="White" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15"/>
                    <TextBlock Name="RearRightWheelTmp" Text="" Foreground="White" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15"/>
                </Grid>

                <Grid Grid.Row="2">
                    <TextBlock Text="TYRE WEAR" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" />
                </Grid>

                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <TextBlock Name="FrontLeftWheelWear" Text="" Foreground="White" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15"/>
                    <TextBlock Name="FrontRightWheelWear" Text="" Foreground="White" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15"/>
                    <TextBlock Name="RearLeftWheelWear" Text="" Foreground="White" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15"/>
                    <TextBlock Name="RearRightWheelWear" Text="" Foreground="White" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15"/>
                </Grid>

                <Grid Grid.Row="4">
                    <TextBlock Text="BREAK TMP" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" />
                </Grid>

                <Grid Grid.Row="5">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <TextBlock Name="FrontLeftBreakTmp" Text="" Foreground="White" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15"/>
                    <TextBlock Name="FrontRightBreakTmp" Text="" Foreground="White" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15"/>
                    <TextBlock Name="RearLeftBreakTmp" Text="" Foreground="White" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15"/>
                    <TextBlock Name="RearRightBreakTmp" Text="" Foreground="White" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15"/>
                </Grid>
            </Grid>


            <Grid Grid.Row="1" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width=".1*"/>
                    <ColumnDefinition Width=".8*"/>
                    <ColumnDefinition Width=".1*"/>
                </Grid.ColumnDefinitions>

                <ProgressBar Grid.Column="0" Name="BrakeProgressBar" Minimum="0" Maximum="1" Value="0" Foreground="Red" Background="Transparent" Orientation="Vertical" Margin="2, 2, 2, 2" BorderBrush="Transparent"/>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height=".1*"/>
                        <RowDefinition Height=".9*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width=".5*"/>
                            <ColumnDefinition Width=".5*"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0" Fill="White"/>
                        <ProgressBar Name="SteeringLeftProgressBar" Grid.Column="0" Minimum="0" Maximum="1" Value="1" Foreground="Black" Background="White" BorderBrush="Transparent" />
                        <ProgressBar Name="SteeringRightProgressBar" Grid.Column="1" Minimum="0" Maximum="1" Value="0" Foreground="White" Background="Black" BorderBrush="Transparent" />

                    </Grid>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" >
                        <TextBlock Name="GearText" Text="N" Foreground="#0000FF" FontSize="60" FontWeight="Black" HorizontalAlignment="Center"/>
                        <TextBlock Name="SpeedText" Text="0" Foreground="#FFFFFF" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Name="RpmText" Text="0" Foreground="#AAAAAA" FontSize="20" HorizontalAlignment="Center" />
                    </StackPanel>

                </Grid>

                <ProgressBar Grid.Column="2" Name="ThrottleProgressBar" Minimum="0" Maximum="1" Value="0" Foreground="Green" Background="Transparent" Orientation="Vertical" Margin="2, 2, 2, 2" BorderBrush="Transparent"/>

            </Grid>


            <Grid Grid.Column="2" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height=".25*"/>
                    <RowDefinition Height=".30*"/>
                    <RowDefinition Height=".20*"/>
                    <RowDefinition Height=".25*"/>
                </Grid.RowDefinitions>


                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.2*"/>
                        <ColumnDefinition Width="0.8*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="CT" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Name="CurrentLapTime" Text="99:99:999" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="BT" FontSize="20" Foreground="Purple" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Name="BestLapTime" Text="99:99:999" FontSize="20" Foreground="Purple" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height=".25*"/>
                        <RowDefinition Height=".6*"/>
                        <RowDefinition Height=".15*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="CURRENT LAP TIME" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Name="CurrentSector1Time" FontSize="12" Text="99:99:999" Grid.Row="1" Grid.Column="0" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Name="CurrentSector2Time" FontSize="12" Text="99:99:999" Grid.Row="1" Grid.Column="1" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Name="CurrentSector3Time" FontSize="12" Text="99:99:999" Grid.Row="1" Grid.Column="2" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Rectangle Name="CurrentSector1TimeStatus" Grid.Column="0" Fill="Yellow"/>
                        <Rectangle Name="CurrentSector2TimeStatus" Grid.Column="1" Fill="Yellow"/>
                        <Rectangle Name="CurrentSector3TimeStatus" Grid.Column="2" Fill="Yellow"/>

                    </Grid>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height=".3*"/>
                        <RowDefinition Height=".7*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="BEST LAP TIME" Foreground="Purple" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Name="BestSector1Time" FontSize="12" Text="99:99:999" Grid.Row="1" Grid.Column="0" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Name="BestSector2Time" FontSize="12" Text="99:99:999" Grid.Row="1" Grid.Column="1" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Name="BestSector3Time" FontSize="12" Text="99:99:999" Grid.Row="1" Grid.Column="2" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Grid>

                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width=".25*"/>
                        <ColumnDefinition Width=".75*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="FUEL" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White"/>
                    <ProgressBar Name="FuelProgressBar" Foreground="Red" Background="Transparent" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="100" Value="50" Margin="2, 2, 2, 2" BorderBrush="Transparent" />
                    <TextBlock Name="FuelText" Grid.Row="2" Grid.Column="1" Text="50.0%" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                </Grid>
            </Grid>
        </Grid>

    </Border>
</Window>
    
    